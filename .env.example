PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automated_pipeline?schema=public"
REDIS_URL="redis://localhost:6379"

# GitHub API configuration (optional - higher rate limits with token)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cron schedule for GitHub repo fetching (default: every 20 seconds)
# Format: node-cron expression with optional seconds field
GITHUB_CRON_SCHEDULE="*/20 * * * * *"

# LLM provider for security risk categorization (optional override)
# When unset: uses Anthropic if ANTHROPIC_API_KEY is set, otherwise OpenAI
# LLM_PROVIDER=anthropic
# LLM_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o-mini
