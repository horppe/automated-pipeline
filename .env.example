PORT=3000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/automated_pipeline?schema=public"
REDIS_URL="redis://localhost:6379"

# GitHub API configuration (optional - higher rate limits with token)
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=

# Cron schedule for GitHub repo fetching (default: every 6 hours)
# Format: standard cron expression (see: https://crontab.guru)
GITHUB_CRON_SCHEDULE="0 */6 * * *"
