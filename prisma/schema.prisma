generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Repository {
  id            String   @id @default(cuid())
  githubId      Int      @unique
  name          String
  fullName      String   @unique
  description   String?
  url           String   @unique
  language      String?
  stars         Int      @default(0)
  forks         Int      @default(0)
  openIssues    Int      @default(0)
  owner         String
  lastFetchedAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([owner])
  @@index([lastFetchedAt])
  @@map("repositories")
}
